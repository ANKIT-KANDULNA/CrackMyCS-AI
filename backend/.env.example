# Backend Environment Variables — Copy this to `.env` and fill in the values

# ── Required ──────────────────────────────────────────────────────────────────

# Your Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (Production Only) ────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset for local development (defaults to allowing all origins).
# Set to your Vercel URL in production to restrict access.
# Example: ALLOWED_ORIGINS=https://crackmycs.vercel.app,https://crackmycs.ai
ALLOWED_ORIGINS=
