# Backend Environment Variables — Copy this to `.env` and fill in the values

# ── Required ──────────────────────────────────────────────────────────────────

# Your Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq chat model (defaults to openai/gpt-oss-20b, a fast, reliable
# model that returns JSON. The old llama-3.3-70b-versatile no longer exists
# on Groq and caused silent fallbacks to mock responses.)
# GROQ_MODEL=openai/gpt-oss-20b

# Your Pinecone API key — get one free at https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# JWT Secret Key for authentication (generate with: openssl rand -base64 32)
# REQUIRED - backend will fail to start if not set
JWT_SECRET_KEY=your-jwt-secret-key-here

# Shared secret for OAuth callback from NextAuth (must match frontend AUTH_CALLBACK_SECRET)
# Generate with: openssl rand -base64 32
# REQUIRED - OAuth callback will fail if not set
AUTH_CALLBACK_SECRET=your-auth-callback-secret

# ── Optional (Production Only) ────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset for local development (defaults to allowing all origins).
# Set to your Vercel URL in production to restrict access.
# Example: ALLOWED_ORIGINS=https://crackmycs.vercel.app,https://crackmycs.ai
ALLOWED_ORIGINS=

# Database URL (defaults to SQLite if not set)
# For production: use PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database
