# Frontend Environment Variables — Copy this to `.env.local` for local development

# Backend API URL (used for auth sync and chat queries)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Shared secret between NextAuth and backend (must match backend AUTH_CALLBACK_SECRET)
# Generate with: openssl rand -base64 32
# REQUIRED - OAuth callback will fail if not set
# The default below matches the backend's dev default so local development works out of the box.
AUTH_CALLBACK_SECRET=dev-auth-secret-change-in-production

# OAuth Provider
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: http://localhost:3000/api/auth/callback/google
#   For production: https://your-frontend-url.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth (generate secret with: openssl rand -base64 32)
# REQUIRED - NextAuth will fail in production if not set
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
