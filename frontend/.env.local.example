# Frontend Environment Variables — Copy this to `.env.local` for local development

# URL of the deployed backend API (FastAPI on Render/Railway)
# - For LOCAL development: Leave blank (auto-detects http://localhost:8000)
# - For PRODUCTION: Set to your deployed backend URL on Render/Railway
#   Example: https://crackmycs-api.onrender.com
NEXT_PUBLIC_API_URL=
